+import asyncio
+import time
+import unittest
+from unittest.mock import AsyncMock, patch
+
+from socketio.exceptions import ConnectionRefusedError
+
+from frappe.realtime import dispatch
+from frappe.realtime.registry import Registry
+from frappe.realtime.server import create_sio
+from frappe.tests.test_realtime_py import FakeSio, make_config, make_session
+
+
+class TestRealtimeSession(unittest.IsolatedAsyncioTestCase):
+	def test_native_session_has_no_federation_deadline(self):
+		session = make_session()
+		session.update_deadline({"user": session.user}, time.monotonic())
+		self.assertIsNone(session.deadline)
+		self.assertFalse(session.is_expired)
+
+	def test_initial_deadline_includes_authentication_latency(self):
+		session = make_session()
+		with self.assertRaises(ConnectionRefusedError):
+			session.update_deadline({"user": session.user, "passport_ttl": 1}, time.monotonic() - 2)
+
+	def test_invalid_or_missing_deadline_cannot_renew_federation(self):
+		for ttl in (None, 0, -1, True, "30", float("nan"), float("inf")):
+			with self.subTest(ttl=ttl):
+				session = make_session()
+				session.deadline = time.monotonic() + 30
+				previous = session.deadline
+				with self.assertRaises(ConnectionRefusedError):
+					session.update_deadline({"user": session.user, "passport_ttl": ttl}, time.monotonic())
+				self.assertEqual(session.deadline, previous)
+
+	def test_changed_user_or_expired_response_cannot_renew(self):
+		for deadline, user in ((time.monotonic() + 30, "another@example.com"), (0, "a@b.com")):
+			session = make_session()
+			session.deadline = deadline
+			with self.assertRaises(ConnectionRefusedError):
+				session.update_deadline({"user": user, "passport_ttl": 60}, time.monotonic())
+
+	async def test_idle_socket_disconnects_at_deadline(self):
+		session = make_session(request=AsyncMock())
+		session.deadline = time.monotonic() + 0.02
+		sio = AsyncMock()
+		await asyncio.wait_for(session.validate_until_disconnect(sio, "sid", "/s1"), timeout=1)
+		sio.disconnect.assert_awaited_once_with("sid", namespace="/s1")
+		session.request.assert_not_awaited()
+
+	async def test_authority_failure_disconnects(self):
+		for result in ({"message": {"user": "Guest"}}, OSError("unavailable")):
+			with self.subTest(result=result):
+				request = AsyncMock()
+				if isinstance(result, Exception):
+					request.side_effect = result
+				else:
+					request.return_value = result
+				session = make_session(request=request)
+				session.deadline = time.monotonic() + 30
+				sio = AsyncMock()
+				with patch("frappe.realtime.auth.asyncio.sleep", new=AsyncMock()):
+					await session.validate_until_disconnect(sio, "sid", "/s1")
+				sio.disconnect.assert_awaited_once()
+
+	async def test_response_after_expiry_is_not_returned(self):
+		session = make_session()
+
+		async def slow_response(*args, **kwargs):
+			session.deadline = 0
+			return {"private": "value"}
+
+		session.request = slow_response
+		session.deadline = time.monotonic() + 30
+		with self.assertRaises(ConnectionRefusedError):
+			await session.get("/protected")
+
+	async def test_handler_expiring_during_work_cannot_acknowledge_or_emit(self):
+		session = make_session()
+		session.deadline = time.monotonic() + 30
+		sio = FakeSio()
+		sio.sessions["sid"] = session
+		sio.disconnect = AsyncMock()
+		registry = Registry()
+
+		async def handler(socket):
+			session.deadline = 0
+			await socket.emit("private", {"secret": "fixture"})
+			return {"secret": "fixture"}
+
+		registry.on("private")(handler)
+		with patch.object(dispatch, "realtime", registry):
+			result = await dispatch._run_handlers(sio, "private", "/s1", "sid", ())
+		self.assertIsNone(result)
+		self.assertEqual(sio.emits, [])
+		sio.disconnect.assert_awaited_once()
+
+	async def test_room_delivery_filters_expired_recipients(self):
+		sio = create_sio()
+		sessions = {name: make_session() for name in ("native", "active", "expired")}
+		sessions["active"].deadline = time.monotonic() + 30
+		sessions["expired"].deadline = 0
+		for sid in sessions:
+			sio.manager.basic_enter_room(sid, "/s1", None, eio_sid="engine-" + sid)
+			sio.manager.basic_enter_room(sid, "/s1", "room")
+		sio.get_session = AsyncMock(side_effect=lambda sid, namespace: sessions[sid])
+		sio._send_eio_packet = AsyncMock()
+		await sio.emit("private", {"value": "fixture"}, to="room", namespace="/s1")
+		self.assertEqual(
+			{call.args[0] for call in sio._send_eio_packet.await_args_list},
+			{"engine-native", "engine-active"},
